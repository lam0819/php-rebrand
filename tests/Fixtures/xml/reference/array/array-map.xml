<?xml version="1.0" encoding="utf-8"?>
<refentry xml:id="function.array-map" xmlns="http://docbook.org/ns/docbook">
 <refnamediv>
  <refname>array_map</refname>
  <refpurpose>Applies the callback to the elements of the given arrays</refpurpose>
 </refnamediv>
 <refsect1 role="description">
  <title>Description</title>
  <methodsynopsis>
   <type>array</type><methodname>array_map</methodname>
   <methodparam><type class="union"><type>callable</type><type>null</type></type><parameter>callback</parameter></methodparam>
   <methodparam><type>array</type><parameter>array</parameter></methodparam>
   <methodparam rep="repeat"><type>array</type><parameter>arrays</parameter></methodparam>
  </methodsynopsis>
  <para>
   <function>array_map</function> returns an <type>array</type> containing the
   results of applying the <parameter>callback</parameter> to the corresponding
   value of <parameter>array</parameter>.
  </para>
 </refsect1>
</refentry>
